{
  "name": "cv-foods-auth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit --incremental false --project tsconfig.app.json && tsc --noEmit --incremental false --project tsconfig.node.json && vite build --configLoader native",
